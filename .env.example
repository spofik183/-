PORT=3000
NODE_ENV=development

# Skupi mini-AI — server only
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# E-mail OTP — Resend
RESEND_API_KEY=
EMAIL_FROM=Skupki <code@your-domain.example>
OTP_PEPPER=change-this-to-a-long-random-secret

# Payment provider: mock | yookassa
PAYMENT_PROVIDER=mock
ENABLE_REAL_PAYOUTS=false

# YooKassa payouts — only after official merchant onboarding
YOOKASSA_GATEWAY_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_AGENT_ID=
