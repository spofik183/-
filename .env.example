# App
NODE_ENV=production
PORT=3000
PUBLIC_URL=https://YOUR-SERVICE.up.railway.app

# OpenAI — Skupi mini-AI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# E-mail OTP (Resend)
RESEND_API_KEY=
EMAIL_FROM=Skupki <code@your-domain.example>
OTP_PEPPER=replace-with-long-random-secret

# Payments
# mock = safe test mode; yookassa = real provider after merchant/KYC setup
PAYMENT_PROVIDER=mock
ENABLE_REAL_PAYOUTS=false
ENABLE_REAL_TOPUPS=false

# YooKassa payouts
YOOKASSA_GATEWAY_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_WIDGET_ACCOUNT_ID=
YOOKASSA_AGENT_ID=

# YooKassa wallet top-ups
YOOKASSA_SHOP_ID=
YOOKASSA_PAYMENT_SECRET_KEY=
PAYMENT_RETURN_URL=https://YOUR-SERVICE.up.railway.app/wallet

# Only for internal demo approval. Keep false/off in a real deployment unless you add admin auth.
ALLOW_DEMO_APPROVE=false
